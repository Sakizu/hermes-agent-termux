--- a/pm/environment.py
+++ b/pm/environment.py
@@ -381,6 +381,20 @@ class PythonEnvironment:
             command += ["--extra", extra]
         for group in sorted(set(groups)):
             command += ["--group", group]
+        # Termux/Android: uv cannot build native extensions from source here.
+        # Rust crates fail (rustup has no aarch64-linux-android toolchain and
+        # maturin bootstraps via rustup); C extensions fail (no NDK in the pm
+        # venv). The .deb ships our cross-built wheels under
+        # .../lib/hermes-agent/wheelhouse/ -- point uv at them so it installs
+        # binaries instead of attempting source builds. Pure-Python packages
+        # still resolve from PyPI as usual; --find-links is additive.
+        # Guarded by wheelhouse presence: the path is Termux-specific, so
+        # this is a no-op everywhere else, and no-op if the wheelhouse is
+        # absent (e.g. non-deb installs). NB: sys.platform is "linux" on
+        # Termux, not "android", so we do NOT gate on sys.platform.
+        _wh = Path("/data/data/com.termux/files/usr/lib/hermes-agent/wheelhouse")
+        if _wh.is_dir() and any(_wh.glob("*.whl")):
+            command += ["--find-links", str(_wh)]
         result = self._run(command, cwd=source, timeout=timeout)
         if result.returncode:
             raise classify_uv_failure("sync", result.returncode, result.stderr or result.stdout)
