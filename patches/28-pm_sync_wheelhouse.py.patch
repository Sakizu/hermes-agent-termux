+        # Termux/Android: uv cannot build native extensions from source here.
+        # Rust crates fail (rustup has no aarch64-linux-android toolchain and
+        # maturin bootstraps via rustup). The .deb ships cross-built wheels
+        # under .../lib/hermes-agent/wheelhouse/; exclude those packages from
+        # `uv sync` (else uv falls back to the locked sdist and builds it)
+        # and install the prebuilt wheels directly afterwards. Pure-Python
+        # packages still resolve from PyPI as usual.
+        # Guarded by wheelhouse presence: the path is Termux-specific, so
+        # this is a no-op everywhere else, and no-op if the wheelhouse is
+        # absent (e.g. non-deb installs). NB: sys.platform is "android" on
+        # Termux (PEP 738, Python 3.13+), but we gate on the wheelhouse path
+        # instead so the patch stays correct even if the interpreter changes.
+        # Wheel filenames: {name}-{version}-{py}-{abi}-{plat}.whl; the build
+        # derives versions from uv.lock, so wheel == locked version by
+        # construction.
+        _wh = Path("/data/data/com.termux/files/usr/lib/hermes-agent/wheelhouse")
+        _wh_wheels: list[Path] = sorted(_wh.glob("*.whl")) if _wh.is_dir() else []
+        if _wh_wheels:
+            # The pm-managed Python is not the Termux system Python, so the
+            # dynamic linker does not search $PREFIX/lib by default. Prebuilt
+            # wheels like cryptography need libssl.so.3 at import time.
+            # Export for this process and all children (uv, venv python).
+            import os as _os
+            _tl = "/data/data/com.termux/files/usr/lib"
+            _ld = _os.environ.get("LD_LIBRARY_PATH", "")
+            if _tl not in _ld.split(":"):
+                _os.environ["LD_LIBRARY_PATH"] = f"{_tl}:{_ld}" if _ld else _tl
+        for _w in _wh_wheels:
+            _pkg = _w.name.split("-")[0].replace("_", "-").lower()
+            command += ["--no-install-package", _pkg]
         result = self._run(command, cwd=source, timeout=timeout)
         if result.returncode:
             raise classify_uv_failure("sync", result.returncode, result.stderr or result.stdout)
+        if _wh_wheels:
