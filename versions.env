# Toolchain pins for the hermes-agent Termux-native .deb build.
# These are the inputs that do NOT come from upstream's uv.lock
# (wheel versions/sdist hashes are read from the target checkout's
# uv.lock at build time, so upstream dep bumps are followed automatically).

# --- Android NDK (cross-compiler) ---
NDK_VERSION=r27c
NDK_URL=https://dl.google.com/android/repository/android-ndk-r27c-linux.zip
NDK_SHA256=59c2f6dc96743b5daf5d1626684640b20a6bd2b1d85b13156b90333741bad5cc

# --- Termux python (target interpreter: headers + libpython for linking) ---
# Pinned: wheels are tagged cp314 and link libpython3.14.so.
# If Termux ever ships 3.15+, this whole file needs re-pinning (build fails
# loudly on the version check in 00-toolchain.sh).
TERMUX_PYTHON_VERSION=3.14.6
TERMUX_PYTHON_DEB_URL=https://packages.termux.dev/apt/termux-main/pool/main/p/python/python_3.14.6-1_aarch64.deb
TERMUX_PYTHON_SHA256=3166e56c2b6c03fff41191fbb9d736302978e7c484702814d9f6dc99dd6006bd

# --- Termux APT repo (for resolving build-time system libs) ---
TERMUX_PACKAGES_URL=https://packages.termux.dev/apt/termux-main/dists/stable/main/binary-aarch64/Packages

# --- Build tools ---
RUST_TOOLCHAIN=stable
MATURIN_VERSION=1.15.0
NODE_MAJOR=24
PATCHELF_PYPI_VERSION=0.19.1

# --- Target ---
ANDROID_API=24
ANDROID_ARCH=aarch64
# Upstream repo we track
UPSTREAM_REPO=NousResearch/hermes-agent
